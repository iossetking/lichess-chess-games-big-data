# Model weights are stored with Git LFS so the repository stays small. The
# cleaned Parquet samples are generated locally by notebook 01 and are not
# tracked.
data/models/**/*.pt filter=lfs diff=lfs merge=lfs -text
data/models/**/*.pth filter=lfs diff=lfs merge=lfs -text
data/models/**/*.safetensors filter=lfs diff=lfs merge=lfs -text
data/models/**/*.onnx filter=lfs diff=lfs merge=lfs -text
