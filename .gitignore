# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Build and packaging artifacts
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# Test, lint, and type-check caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyright/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Notebook and Marimo-generated files
.ipynb_checkpoints/
__marimo__/
.marimo/

# Local datasets and downloaded cache
/data/

# Local environment variables and secrets
.env
.env.*
!.env.example

# OS metadata
.DS_Store
Thumbs.db
*.swp
*~

# Editor / IDE
.vscode/
.idea/

# Logs
*.log

# Generated outputs and artifacts
/outputs/

# Superpowers / agent working directories
superpowers/
.superpowers/

# Docs: keep local/generated files out of Git, except the shared technical guide.
/docs/*
!/docs/vision_tecnica_tablero.md
!/docs/Documento_Tecnico_Vision_Tablero_Ajedrez.docx
